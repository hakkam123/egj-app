<?xml version="1.0" encoding="UTF-8"?>
<!--
  JAGO - web.config FAIL-SAFE di root project.

  File ini TIDAK boleh terjangkau user kalau IIS site di-setup dengan benar
  (Physical Path harus menunjuk ke egj-app/public/, BUKAN egj-app/).

  Tapi kalau ada misconfig (admin IT salah set path), web.config ini akan:
    1. Memblokir semua akses ke .env, composer.json, source code PHP, dll
    2. Menampilkan pesan jelas supaya admin tahu salah path

  Dengan cara ini, risiko bocornya .env (yang berisi password SMTP, SQL Server,
  dll) tidak terjadi walau ada human error di setup IIS.
-->
<configuration>
    <system.webServer>

        <!-- Blokir SEMUA request dengan error 403 -->
        <security>
            <requestFiltering>
                <denyUrlSequences>
                    <add sequence="/" />
                </denyUrlSequences>
            </requestFiltering>
        </security>

        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="403" subStatusCode="-1" />
            <error statusCode="403"
                   prefixLanguageFilePath=""
                   path="/misconfig.html"
                   responseMode="File" />
        </httpErrors>

        <directoryBrowse enabled="false" />
        <defaultDocument enabled="false" />

    </system.webServer>
</configuration>
