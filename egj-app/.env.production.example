# ==============================================================================
# JAGO — .env PRODUCTION TEMPLATE
# ==============================================================================
# Copy file ini jadi `.env` di server production, lalu ganti nilai yang
# bertanda <GANTI>. JANGAN commit file .env ke git — hanya template ini.
#
# Setelah file ini di-set:
#   php artisan key:generate         (generate APP_KEY baru - WAJIB)
#   php artisan config:cache         (cache config untuk performa)
#   php artisan migrate --force      (jalankan migrasi)
# ==============================================================================


# ---------- 1. Application ----------
APP_NAME="JAGO"
APP_ENV=production
APP_KEY=                                         # <GANTI> jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://jago.astra-visteon.net           # <GANTI> dengan URL asli production

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# ---------- 2. Database (SQL Server) ----------
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1                                # <GANTI> kalau SQL Server di host berbeda
DB_PORT=1433
DB_DATABASE=egj_app                              # <GANTI> dengan nama database production
DB_USERNAME=sa                                   # <GANTI> dengan SQL user khusus (jangan sa)
DB_PASSWORD=                                     # <GANTI>

# Opsional (kalau SQL Server pakai instance named):
# DB_HOST=SERVERNAME\SQLEXPRESS


# ---------- 3. Session + Cache ----------
# Pakai database (paling simpel di Windows IIS, tidak perlu Redis service).
# Kalau mau pakai Redis, pastikan Redis service di-install dulu.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync                            # Pakai sync — tidak perlu queue worker

BROADCAST_CONNECTION=log


# ---------- 4. Logging ----------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PENTING: 'warning' di produksi. 'debug' bisa bikin log 400+ MB/hari kalau Redis mati.
LOG_LEVEL=warning
LOG_DAILY_DAYS=14


# ---------- 5. Mail SMTP Astra Visteon ----------
MAIL_MAILER=smtp
MAIL_SCHEME=tls                                  # Port 587 = STARTTLS (bukan "null" atau "ssl")
MAIL_HOST=astra-visteon.net
MAIL_PORT=587
MAIL_USERNAME=no-reply@astra-visteon.net
# PENTING: password harus pakai DOUBLE QUOTE karena ada karakter # yang di
# .env dianggap awal komentar. Single quote TIDAK bekerja di .env Laravel.
MAIL_PASSWORD="AVInoreply57428@!#"
MAIL_FROM_ADDRESS="finance.service@astra-visteon.net"
MAIL_FROM_NAME="Finance Service"


# ---------- 6. Inertia / Frontend ----------
# Matikan SSR karena JAGO tidak build SSR bundle. Kalau tidak dimatikan,
# setiap request HTTP akan menunggu 2-3 detik koneksi ke SSR server yang
# tidak ada.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"


# ---------- 7. Yang BELUM diperlukan di production (biarkan default) ----------
# REDIS_*       — hanya kalau Anda ganti SESSION/CACHE jadi redis
# AWS_*         — hanya kalau pakai S3 untuk file upload
# MEMCACHED_*   — tidak dipakai
