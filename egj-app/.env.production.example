# ---------- 1. Application ----------
APP_NAME="JAGO"
APP_ENV=production
APP_KEY=                                        
APP_DEBUG=false
APP_URL=https://jago.astra-visteon.net           
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12


# ---------- 2. Database (SQL Server) ----------
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1                              
DB_PORT=1433
DB_DATABASE=egj_app                            
DB_USERNAME=sa                                 
DB_PASSWORD=                                     


# ---------- 3. Session + Cache ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync                        

BROADCAST_CONNECTION=log


# ---------- 4. Logging ----------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

LOG_LEVEL=warning
LOG_DAILY_DAYS=14


# ---------- 5. Mail SMTP Astra Visteon ----------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp                                 
MAIL_HOST=astra-visteon.net
MAIL_PORT=587
MAIL_USERNAME=no-reply@astra-visteon.net
MAIL_PASSWORD="AVInoreply57428@!#"
MAIL_FROM_ADDRESS="finance.service@astra-visteon.net"
MAIL_FROM_NAME="Finance Service"


# ---------- 6. Inertia  ----------
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

