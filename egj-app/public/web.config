<?xml version="1.0" encoding="UTF-8"?>
<!--
  JAGO - IIS configuration for the Laravel public/ folder.

  Point IIS site "Physical Path" ke folder ini (bukan ke root project).
  Prasyarat module IIS:
    - URL Rewrite 2.1              https://www.iis.net/downloads/microsoft/url-rewrite
    - FastCGI (bawaan IIS)
    - PHP for Windows + handler mapping ke php-cgi.exe

  Setelah file ini di-copy ke public/, lakukan sekali:
    iisreset
-->
<configuration>
    <system.webServer>

        <!-- 1. Default document -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- 2. URL Rewrite: mirror .htaccess Laravel ke IIS -->
        <rewrite>
            <rules>
                <!-- Hilangkan trailing slash kecuali untuk folder asli -->
                <rule name="Remove trailing slash" stopProcessing="true">
                    <match url="(.*)/$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="{R:1}" />
                </rule>

                <!-- File / folder nyata disajikan apa adanya (gambar, PDF di public/, dsb) -->
                <!-- Semua lainnya forward ke index.php (Laravel front controller) -->
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- 3. Security headers (dipakai semua response) -->
        <httpProtocol>
            <customHeaders>
                <!-- Hilangkan "Server: Microsoft-IIS/x.x" -->
                <remove name="X-Powered-By" />
                <!-- Jangan embed JAGO di iframe luar (clickjacking) -->
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <!-- Jangan sniff MIME type (file .pdf jangan dieksekusi sebagai HTML) -->
                <add name="X-Content-Type-Options" value="nosniff" />
                <!-- Pembatasan referer saat navigasi keluar -->
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <!-- Larang browser kirim data sensor (lokasi, kamera, mic) -->
                <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
            </customHeaders>
        </httpProtocol>

        <!-- 4. Blokir akses ke file sensitif yang kebetulan ada di folder atasnya.
                Kalau IIS Physical Path sudah menunjuk ke public/, teoritis file ini
                tidak terjangkau. Tetap di-add sebagai safety net kalau ada misconfig. -->
        <security>
            <requestFiltering>
                <!-- Upload size: PDF 10MB + supporting 10MB * beberapa. Kasih 50MB buffer. -->
                <requestLimits maxAllowedContentLength="52428800" />
                <!-- Blokir request ke file dengan nama/ekstensi berbahaya -->
                <fileExtensions>
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".ini" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".sqlite" allowed="false" />
                </fileExtensions>
                <!-- Blokir request yang hit folder sensitif Laravel -->
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".github" />
                    <add segment=".vscode" />
                    <add segment="app" />
                    <add segment="bootstrap" />
                    <add segment="config" />
                    <add segment="database" />
                    <add segment="node_modules" />
                    <add segment="resources" />
                    <add segment="routes" />
                    <add segment="scripts" />
                    <add segment="storage" />
                    <add segment="tests" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- 5. MIME types tambahan untuk font modern -->
        <staticContent>
            <remove fileExtension=".woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <!-- Browser cache aset build Vite 1 tahun (filename sudah ber-hash) -->
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        </staticContent>

        <!-- 6. Kompresi: hemat bandwidth untuk JS/CSS/HTML/JSON -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- 7. Jangan tampilkan daftar isi direktori (file-listing) -->
        <directoryBrowse enabled="false" />

        <!-- 8. Error pages: pakai response dari Laravel, bukan error IIS default -->
        <httpErrors existingResponse="PassThrough" errorMode="Detailed" />

    </system.webServer>

    <!-- 9. Supaya header Authorization sampai ke PHP (dipakai Sanctum / API tokens) -->
    <location path="." inheritInChildApplications="false">
        <system.webServer>
            <rewrite>
                <allowedServerVariables>
                    <add name="HTTP_AUTHORIZATION" />
                    <add name="HTTP_X_XSRF_TOKEN" />
                </allowedServerVariables>
            </rewrite>
        </system.webServer>
    </location>

</configuration>
