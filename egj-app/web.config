<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <system.webServer>

        <!-- Blokir SEMUA request dengan error 403 -->
        <security>
            <requestFiltering>
                <denyUrlSequences>
                    <add sequence="/" />
                </denyUrlSequences>
            </requestFiltering>
        </security>

        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="403" subStatusCode="-1" />
            <error statusCode="403"
                   prefixLanguageFilePath=""
                   path="/misconfig.html"
                   responseMode="File" />
        </httpErrors>

        <directoryBrowse enabled="false" />
        <defaultDocument enabled="false" />

    </system.webServer>
</configuration>
